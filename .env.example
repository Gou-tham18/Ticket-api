GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Escalation Dashboard: email approval round trip (Task 5)
APPROVAL_USER_NAME=
APPROVAL_USER_EMAIL=
APPROVAL_MANAGER_NAME=
APPROVAL_MANAGER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Optional: send through Brevo's HTTPS API instead of SMTP (used when set).
# Needed on Render's free tier, which blocks outgoing SMTP ports.
BREVO_API_KEY=

# Approve/Reject buttons in the approval email
# Where the manager's browser reaches this backend, e.g. your ngrok dev domain.
# Must start with https:// (http:// only for local testing). Trailing / is removed.
PUBLIC_BASE_URL=
# Long random string (at least 32 characters) that signs the links. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APPROVAL_LINK_SECRET=
# How long Approve/Reject links work, in whole days (1 to 30)
APPROVAL_LINK_DAYS=7
# Days without a decision before a ticket is ready to send again as a Reminder (1 to 30)
APPROVAL_REMINDER_DAYS=1
# Append-only log of which tickets were emailed and when
APPROVAL_EMAIL_LOG_PATH=data/approval_emails.csv
